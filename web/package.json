{
  "name": "mon-patrimoine",
  "version": "1.0.0",
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "description": "Web application to track your financial wealth and its estimated net value (after social charges and taxes).",
  "scripts": {
    "predev": "bun run vendor",
    "dev": "tsc --watch & python3 -m http.server 5500",
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "vendor": "bash scripts/vendor-csm.sh",
    "postinstall": "bun run vendor"
  },
  "type": "module",
  "trustedDependencies": ["ts-cloud-storage-manager"],
  "dependencies": {
    "ts-cloud-storage-manager": "github:fathzer/ts-cloud-storage-manager#v0.0.1-preview"
  }
}
