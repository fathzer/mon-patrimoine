{
  // Type-checks test files, which the build tsconfig excludes (they must
  // not be emitted into dist/, deployed verbatim by the workflow).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // tests/ lives outside src/, so the src rootDir constraint is dropped.
    "rootDir": "."
  },
  "include": ["src/**/*.test.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
